#!/usr/bin/env python3
"""Godot Launcher — pick a Godot version from ~/Applications/Godot/ and run it.

The directory is rescanned on every run, so newly downloaded versions show up
with no configuration. The launcher also keeps the Actions= jump list in its own
.desktop file in sync, so a version can be launched by right-clicking the pinned
panel icon without opening this window.

Install… downloads any stable Godot 4 release from GitHub into the same
directory; Remove… (also the Delete key, or right-click a version) moves one to
the Trash. Without a window (e.g. over SSH):

    godot-launcher --install-latest [--standard]

Set GODOT_LAUNCHER_ROOT to scan somewhere other than ~/Applications/Godot.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
from dataclasses import dataclass
from pathlib import Path
from urllib.request import Request, urlopen

from PyQt6.QtCore import QFile, QSize, Qt, QThread, pyqtSignal
from PyQt6.QtGui import QIcon, QKeySequence, QShortcut
from PyQt6.QtWidgets import (
    QAbstractItemView,
    QApplication,
    QDialog,
    QHBoxLayout,
    QLabel,
